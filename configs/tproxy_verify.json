{
  "suite": {
    "author": "SESHAT",
    "description": "tproxy sudo verification (routing control + TLS1.3 1-gw & 2-gw)",
    "name": "SCG Generated Benchmark Matrix",
    "version": "2.0.0"
  },
  "defaults": {
    "auto_affinity": true,
    "collect_system_metrics": true,
    "confidence_level": 0.95,
    "cooldown_secs": 1,
    "duration_secs": 5,
    "loss_threshold_pct": 1.0,
    "metrics_backend": "procfs",
    "metrics_sample_rate_hz": 5,
    "outlier_removal": "iqr",
    "runs": 3,
    "warmup_secs": 2
  },
  "scenarios": [
    {
      "category": "matrix",
      "connections": 1,
      "description": "matrix: SCG scg-direct, tproxy/plain, 4096B, 1 conn",
      "gateway": {
        "chain": "scg-direct",
        "enabled": true
      },
      "message_size_bytes": 4096,
      "name": "matrix_routing_tproxy_tproxy_4096B_direct_1c",
      "protocol": {
        "protection_mode": "routing-only",
        "type": "none"
      },
      "requirements": {
        "cap_net_admin": true
      },
      "sender": {
        "interface": "tproxy",
        "pattern": "sustained",
        "target_addr": "127.0.0.1:19719"
      }
    },
    {
      "category": "matrix",
      "connections": 1,
      "description": "matrix: SCG scg-direct, tproxy/tls1.3, 4096B, 1 conn",
      "gateway": {
        "chain": "scg-direct",
        "enabled": true
      },
      "message_size_bytes": 4096,
      "name": "matrix_tls13_tproxy_tproxy_4096B_direct_1c",
      "protocol": {
        "type": "tls",
        "version": "1.3"
      },
      "requirements": {
        "cap_net_admin": true,
        "openssl": true
      },
      "sender": {
        "interface": "tproxy",
        "pattern": "sustained",
        "target_addr": "127.0.0.1:19737"
      }
    },
    {
      "category": "matrix",
      "connections": 1,
      "description": "matrix: SCG scg-scg, tproxy/tls1.3, 4096B, 1 conn",
      "gateway": {
        "chain": "scg-scg",
        "enabled": true
      },
      "message_size_bytes": 4096,
      "name": "matrix_tls13_tproxy_tproxy_4096B_scg_1c",
      "protocol": {
        "type": "tls",
        "version": "1.3"
      },
      "requirements": {
        "cap_net_admin": true,
        "openssl": true
      },
      "sender": {
        "interface": "tproxy",
        "pattern": "sustained",
        "target_addr": "127.0.0.1:19743"
      }
    }
  ]
}