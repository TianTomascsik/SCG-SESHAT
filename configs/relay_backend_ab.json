{
  "$schema": "seshat-config-v1",
  "suite": {
    "name": "SCG Relay-Backend A/B (io_uring vs poll+splice)",
    "description": "Splice-eligible paths (routing always splices; kTLS splices when active) across a 1/4/16/64-connection sweep and 64B/16KB/256KB sizes. Run TWICE with the io_uring-feature gateway (SCG_GATEWAY_BIN): SCG_RELAY_IO_URING unset (poll+splice) then =1 (io_uring). Loopback throughput is harness-limited, so read the verdict from ctx_switches_total, mem_io_uring_enter vs mem_splice_syscalls/mem_poll_syscalls (--metrics-backend ebpf, root) and perf_cycles/IPC (--metrics-backend perf).",
    "author": "SESHAT",
    "version": "1.0.0"
  },
  "defaults": {
    "runs": 5,
    "duration_secs": 10,
    "warmup_secs": 3,
    "cooldown_secs": 1,
    "auto_affinity": true,
    "scg_process_name": "gateway",
    "collect_system_metrics": true,
    "metrics_sample_rate_hz": 50,
    "outlier_removal": "iqr",
    "confidence_level": 0.95
  },
  "scenarios": [
    {
      "name": "relaybackend_routing_tcp_64B_1c",
      "category": "relay-backend-routing",
      "message_size_bytes": 64,
      "connections": 1,
      "gateway": {
        "enabled": true,
        "chain": "scg-direct"
      },
      "optimization_flags": {
        "perf_profile": "throughput"
      },
      "sender": {
        "interface": "tcp",
        "target_addr": "127.0.0.1:15200",
        "pattern": "sustained"
