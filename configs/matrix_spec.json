{
  "suite": {
    "name": "SCG Generated Benchmark Matrix",
    "version": "2.0.0",
    "author": "SESHAT"
  },
  "defaults": {
    "runs": 3,
    "duration_secs": 5,
    "warmup_secs": 2,
    "cooldown_secs": 1,
    "auto_affinity": true,
    "collect_system_metrics": true,
    "metrics_backend": "procfs",
    "metrics_sample_rate_hz": 5,
    "outlier_removal": "iqr",
    "confidence_level": 0.95,
    "loss_threshold_pct": 1.0
  },
  "dimensions": {
    "stream_message_sizes": [64, 256, 1024, 4096, 16384, 65536],
    "datagram_message_sizes": [64, 256, 512, 1200, 1400],
    "canonical_connections": [1],
    "nightly_connections": [1, 4, 16, 64],
    "scalability_connections": [1, 4, 16, 64, 256, 1024],
    "catalog_connections": [1, 2, 4, 8, 16, 32, 64, 256, 1024],
    "canonical_stream_message_size": 4096,
    "canonical_datagram_message_size": 1200
  },
  "profiles": [
    {
      "id": "routing_tcp",
      "protocol": { "type": "none", "protection_mode": "routing-only" },
      "interfaces": ["tcp"],
      "chains": ["scg-direct", "scg-scg"],
      "tiers": ["canonical", "nightly"],
      "scalability": true
    },
    {
      "id": "tls12_tcp",
      "protocol": { "type": "tls", "version": "1.2" },
      "interfaces": ["tcp"],
      "chains": ["scg-direct", "scg-scg"],
      "tiers": ["canonical", "nightly"],
      "scalability": true,
      "requirements": ["openssl"]
    },
    {
      "id": "tls13_tcp",
      "protocol": { "type": "tls", "version": "1.3" },
      "interfaces": ["tcp"],
      "chains": ["scg-direct", "scg-scg"],
      "tiers": ["canonical", "nightly"],
      "requirements": ["openssl"]
    },
    {
      "id": "mtls12_tcp",
      "protocol": { "type": "tls", "version": "1.2", "mutual_auth": true },
      "interfaces": ["tcp"],
      "chains": ["scg-direct", "scg-scg"],
      "tiers": ["canonical", "nightly"],
      "requirements": ["openssl"]
    },
    {
      "id": "mtls13_tcp",
      "protocol": { "type": "tls", "version": "1.3", "mutual_auth": true },
      "interfaces": ["tcp"],
      "chains": ["scg-direct", "scg-scg"],
      "tiers": ["canonical", "nightly"],
      "requirements": ["openssl"]
    },
    {
      "id": "ktls12_tcp",
      "protocol": { "type": "tls", "version": "1.2", "kernel": true },
      "interfaces": ["tcp"],
      "chains": ["scg-direct", "scg-scg"],
      "tiers": ["canonical", "nightly"],
      "requirements": ["openssl", "ktls"]
    },
    {
      "id": "ktls13_tcp",
      "protocol": { "type": "tls", "version": "1.3", "kernel": true },
      "interfaces": ["tcp"],
      "chains": ["scg-direct", "scg-scg"],
      "tiers": ["canonical", "nightly"],
      "requirements": ["openssl", "ktls"]
    },
    {
      "id": "integrity_tls12_tcp",
      "protocol": { "type": "tls", "version": "1.2", "protection_mode": "integrity-only" },
      "interfaces": ["tcp"],
      "chains": ["scg-direct"],
      "tiers": ["canonical", "nightly"],
      "requirements": ["openssl"]
    },
    {
      "id": "dtls10_udp",
      "protocol": { "type": "dtls", "version": "1.0" },
      "interfaces": ["udp"],
      "chains": ["scg-direct", "scg-scg"],
      "message_class": "datagram",
      "connections": [1],
      "tiers": ["canonical", "nightly"],
      "requirements": ["openssl", "dtls10"]
    },
    {
      "id": "dtls12_udp",
      "protocol": { "type": "dtls", "version": "1.2" },
      "interfaces": ["udp"],
      "chains": ["scg-direct", "scg-scg"],
      "message_class": "datagram",
      "connections": [1],
      "tiers": ["canonical", "nightly"],
      "requirements": ["openssl"]
    },
    {
      "id": "dtls12_mtls_udp",
      "protocol": { "type": "dtls", "version": "1.2", "mutual_auth": true },
      "interfaces": ["udp"],
      "chains": ["scg-direct"],
      "message_class": "datagram",
      "connections": [1],
      "tiers": ["canonical", "nightly"],
      "requirements": ["openssl"]
    },
    {
      "id": "ale_tls13_udp",
      "protocol": { "type": "tls", "version": "1.3", "app_protocol": "ale" },
      "interfaces": ["udp"],
      "chains": ["scg-direct"],
      "message_class": "datagram",
      "connections": [1],
      "tiers": ["canonical", "nightly"],
      "requirements": ["openssl"]
    },
    {
      "id": "raw_tls13_udp",
      "protocol": { "type": "tls", "version": "1.3", "app_protocol": "raw" },
      "interfaces": ["udp"],
      "chains": ["scg-direct"],
      "message_class": "datagram",
      "connections": [1],
      "tiers": ["canonical", "nightly"],
      "requirements": ["openssl"]
    },
    {
      "id": "routing_uds",
      "protocol": { "type": "none", "protection_mode": "routing-only" },
      "interfaces": ["unix"],
      "chains": ["scg-direct"],
      "connections": [1],
      "tiers": ["canonical", "nightly"]
    },
    {
      "id": "tls13_uds",
      "protocol": { "type": "tls", "version": "1.3" },
      "interfaces": ["unix"],
      "chains": ["scg-direct"],
      "connections": [1],
      "tiers": ["canonical", "nightly"],
      "requirements": ["openssl"]
    },
    {
      "id": "routing_shm",
      "protocol": { "type": "none", "protection_mode": "routing-only" },
      "interfaces": ["shm"],
      "chains": ["scg-direct"],
      "connections": [1],
      "tiers": ["canonical", "nightly"]
    },
    {
      "id": "routing_tproxy",
      "protocol": { "type": "none", "protection_mode": "routing-only" },
      "interfaces": ["tproxy"],
      "chains": ["scg-direct"],
      "connections": [1],
      "tiers": ["canonical", "nightly"],
      "requirements": ["cap_net_admin"]
    }
  ],
  "cipher_matrix": {
    "tls12": [
      "ECDHE-RSA-AES128-GCM-SHA256",
      "ECDHE-RSA-AES256-GCM-SHA384",
      "ECDHE-RSA-CHACHA20-POLY1305"
    ],
    "tls13": [
      "TLS_AES_128_GCM_SHA256",
      "TLS_AES_256_GCM_SHA384",
      "TLS_CHACHA20_POLY1305_SHA256"
    ]
  },
  "hot_reload_profiles": [
    "routing_tcp",
    "tls12_tcp",
    "tls13_tcp",
    "mtls12_tcp",
    "mtls13_tcp",
    "ktls12_tcp",
    "ktls13_tcp",
    "integrity_tls12_tcp"
  ],
  "interface_comparison": {
    "paths": [
      { "id": "tcp_loopback", "interface": "tcp", "gateway": false },
      { "id": "tcp_scg", "interface": "tcp", "gateway": true },
      { "id": "tproxy", "interface": "tproxy", "gateway": true, "requirements": ["cap_net_admin"], "connections": [1] },
      { "id": "uds", "interface": "unix", "gateway": true, "connections": [1] },
      { "id": "shm", "interface": "shm", "gateway": true, "connections": [1] }
    ],
    "throughput_message_sizes": [64, 256, 1024, 4096, 16384, 65536],
    "throughput_connections": [1, 4, 16],
    "latency_message_sizes": [64, 1024, 4096],
    "latency_connections": [1],
    "latency_fraction": 0.5
  },
  "limitations": [
    {
      "name": "ktls_mtls",
      "reason": "SCG falls back to userspace TLS when mutual authentication is requested; this is not a valid kTLS benchmark",
      "interface": "tcp",
      "protocol": { "type": "tls", "version": "1.3", "kernel": true, "mutual_auth": true }
    },
    {
      "name": "dtls_multi_connection",
      "reason": "The DTLS gateway transport has one shared backend datagram flow and cannot report independent parallel connections correctly",
      "interface": "udp",
      "protocol": { "type": "dtls", "version": "1.2" }
    },
    {
      "name": "session_resumption",
      "reason": "SESHAT connection-rate clients create fresh TLS contexts, and SCG does not expose ticket/cache plus resumed-handshake telemetry; a second connection must not be labelled resumed",
      "interface": "tcp",
      "protocol": { "type": "tls", "version": "1.3" }
    },
    {
      "name": "tls_profile_reload_ack",
      "reason": "SCG reload currently diffs rules by name, so a same-name TLS profile change is not applied to the listener lifecycle and has no control-plane acknowledgement; profile-update measurements are withheld",
      "interface": "tcp",
      "protocol": { "type": "tls", "version": "1.3" }
    },
    {
      "name": "gateway_copy_accounting",
      "reason": "RSS/PSS and analytical encapsulation overhead are reported, but SCG does not expose owned framing/TLS/SHM copy, splice, zero-copy-success, or fallback counters; physical copy claims are withheld",
      "interface": "tcp",
      "protocol": { "type": "none", "protection_mode": "routing-only" }
    }
  ]
}
