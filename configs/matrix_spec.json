  "limitations": [
    {
      "name": "dtls_multi_connection",
      "reason": "The DTLS gateway transport has one shared backend datagram flow and cannot report independent parallel connections correctly",
      "interface": "udp",
      "protocol": {
        "type": "dtls",
        "version": "1.2"
      }
    },
    {
      "name": "tls_profile_reload_ack",
      "reason": "SCG reload currently diffs rules by name, so a same-name TLS profile change is not applied to the listener lifecycle and has no control-plane acknowledgement; profile-update measurements are withheld",
      "interface": "tcp",
      "protocol": {
        "type": "tls",
        "version": "1.3"
      }
    },
    {
      "name": "gateway_copy_accounting",
      "reason": "RSS/PSS and analytical encapsulation overhead are reported, but SCG does not expose owned framing/TLS/SHM copy, splice, zero-copy-success, or fallback counters; physical copy claims are withheld",
      "interface": "tcp",
      "protocol": {
        "type": "none",
        "protection_mode": "routing-only"
      }
    },
    {
      "name": "integrity_only_tls13_tcp",
      "reason": "TLS 1.3 has no NULL/integrity-only cipher suite; OpenSSL does not implement the draft TLS_SHA256_SHA256/TLS_SHA384_SHA384 codepoints, so an integrity-only TLS 1.3 handshake negotiates zero ciphersuites and never completes. Integrity-only is TLS 1.2 only \u2014 SCG now rejects the combination at config load (TRA #85). Profile removed from the executable matrix.",
      "interface": "tcp",
      "protocol": {
        "type": "tls",
        "version": "1.3",
        "protection_mode": "integrity-only"
      }
    },
    {
      "name": "integrity_only_tls13_uds",
      "reason": "TLS 1.3 has no NULL/integrity-only cipher suite; integrity-only is TLS 1.2 only (SCG rejects it at config load, TRA #85). Over UDS the dead handshake surfaced as a send-spin the harness watchdog had to kill. Profile removed from the executable matrix.",
      "interface": "unix",
      "protocol": {
        "type": "tls",
        "version": "1.3",
        "protection_mode": "integrity-only"
      }
    },
    {
      "name": "integrity_only_tls13_shm",
      "reason": "TLS 1.3 has no NULL/integrity-only cipher suite; integrity-only is TLS 1.2 only (SCG rejects it at config load, TRA #85). Over SHM the dead handshake surfaced as a send-spin the harness watchdog had to kill. Profile removed from the executable matrix.",
      "interface": "shm",
      "protocol": {
        "type": "tls",
        "version": "1.3",
        "protection_mode": "integrity-only"
      }
    },
    {
      "name": "integrity_only_tls13_tproxy",
      "reason": "TLS 1.3 has no NULL/integrity-only cipher suite; integrity-only is TLS 1.2 only (SCG rejects it at config load, TRA #85). Profile removed from the executable matrix.",
      "interface": "tproxy",
      "protocol": {
        "type": "tls",
        "version": "1.3",
        "protection_mode": "integrity-only"
      }
    },
    {
      "name": "wireguard_script_orchestrated",
      "reason": "WireGuard is a kernel-offload provider that needs CAP_NET_ADMIN, the wireguard module, and a peer network namespace; it is benchmarked by the privileged scripts/wg_bench.sh orchestration (see scripts/perf_gate.sh), outside the unified seshat run",
      "interface": "udp",
      "protocol": {
        "type": "wireguard"
      }
    },
    {
      "name": "subset146_psk_tls13",
      "reason": "subset146-psk is a pre-shared-key profile; PSK-only handshakes were removed in TLS 1.3, so SCG rejects subset146-psk on TLS 1.3 at config load: 'subset146-psk requires TLS 1.2 (PSK-only handshakes were removed in TLS 1.3)'. The PKI variant (subset146-pki) is TLS 1.3 capable and stays in the executable matrix. Profile removed from the executable matrix.",
      "interface": "tcp",
      "protocol": {
        "type": "tls",
        "version": "1.3",
        "profile": "subset146-psk"
      }
    },
    {
      "name": "remote_two_host_wire",
      "reason": "A two-host measurement needs a second physical machine on an Ethernet link plus root for tc and tcpdump, so it cannot run in the unified seshat suite: build_path() binds the ingress and the inter-gateway mid hop on loopback (src/gateway/mod.rs), and the decisive artefact is a far-side packet capture, which no harness code produces. It is benchmarked by the privileged scripts/wire_bench.sh orchestration (peer side scripts/wire_peer.sh), mirroring how the WireGuard provider is handled. Note the wire path is mutual-TLS only: the gateway's M-13 check makes verify != mutual a hard validation error once the decrypt listener is non-loopback, so an unauthenticated wire deployment is refused by construction.",
      "interface": "tcp",
      "chain": "scg-scg",
      "protocol": {
        "type": "tls",
        "version": "1.3",
        "mutual_auth": true
      }
    }
  ]
