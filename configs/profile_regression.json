{
  "$schema": "seshat-config-v1",
  "suite": {
    "name": "SCG Profile Regression Gate",
    "description": "Compact profile gate for SCG routing, TLS 1.3, and kTLS 1.3 across latency, balanced, and throughput profiles.",
    "author": "SESHAT",
    "version": "1.0.0"
  },
  "defaults": {
    "runs": 2,
    "duration_secs": 1,
    "warmup_secs": 1,
    "cooldown_secs": 0,
    "auto_affinity": true,
    "scg_process_name": "gateway",
    "collect_system_metrics": true,
    "metrics_sample_rate_hz": 5,
    "outlier_removal": "iqr",
    "confidence_level": 0.95
  },
  "scenarios": [
    {
      "name": "profile_direct_throughput_1KB",
      "category": "profile-throughput",
      "message_size_bytes": 1024,
      "connections": 1,
      "sender": {
        "interface": "tcp",
        "target_addr": "127.0.0.1:14100",
        "pattern": "sustained"
      }
    },
    {
      "name": "profile_direct_latency_1KB",
      "category": "profile-latency",
      "message_size_bytes": 1024,
      "connections": 1,
      "sender": {
        "interface": "tcp",
        "target_addr": "127.0.0.1:14101",
        "pattern": "periodic",
        "interval_us": 500
      }
    },
    {
      "name": "profile_direct_pingpong_1KB",
      "category": "profile-rtt",
      "mode": "pingpong",
      "message_size_bytes": 1024,
      "connections": 1,
      "sender": {
        "interface": "tcp",
        "target_addr": "127.0.0.1:14102",
        "pattern": "sustained"
      }
    },

    {
      "name": "profile_routing_latency_throughput_1KB",
      "category": "profile-throughput",
      "message_size_bytes": 1024,
      "connections": 1,
      "gateway": { "enabled": true, "chain": "scg-direct" },
      "protocol": { "type": "none" },
      "optimization_flags": { "perf_profile": "latency" },
      "sender": { "interface": "tcp", "target_addr": "127.0.0.1:14110", "pattern": "sustained" }
    },
