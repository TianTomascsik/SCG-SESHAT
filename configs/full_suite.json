{
  "$schema": "seshat-config-v1",
  "suite": {
    "name": "SCG Full Feature Suite",
    "description": "Complete interface × protocol × mode × topology matrix. Exercises all newly-wired paths: UDS, SHM, TPROXY, ALE/RAW UDP-over-TLS, DSCP priority streams, hot-reload, optimization flags (zero_copy/spin_wait), network impairment, and multi-topology (veth/netns). WireGuard and IPSec scenarios are disabled (reason documented). Privileged tests (TPROXY, netns, netem) will be skipped with a warning when CAP_NET_ADMIN is unavailable.",
    "author": "SESHAT",
    "version": "2.0.0"
  },
  "defaults": {
    "runs": 3,
    "duration_secs": 5,
    "warmup_secs": 2,
    "cooldown_secs": 1,
    "cpu_affinity_sender": [],
    "cpu_affinity_receiver": [],
    "scg_process_name": "gateway",
    "collect_system_metrics": true,
    "metrics_backend": "perf",
    "metrics_sample_rate_hz": 10,
    "outlier_removal": "iqr",
    "confidence_level": 0.95
  },
  "scenarios": [
